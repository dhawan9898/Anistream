# AniStream Environment Variables
# No secret keys required for client-side catalog and video streaming.

# Optional: TMDB API key (the same one CineStream uses). Turns on story arcs in the episode picker.
# VITE_TMDB_API_KEY=

# Sign-in and sync between devices (optional; see supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
