<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Transparent touch surface for gestures: double-tap seek, vertical swipe volume/brightness -->
    <View
        android:id="@+id/gesture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bounded top/bottom scrims (Netflix-style: clear video in the middle, not a full wash) -->
    <View
        android:id="@+id/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top" />

    <View
        android:id="@+id/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom" />

    <!-- Gesture feedback indicator (volume / brightness) -->
    <TextView
        android:id="@+id/gesture_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Next Episode card -->
    <LinearLayout
        android:id="@+id/next_episode_card"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_next_episode_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_next_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_play_next_now"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="▶  Play Now"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- All chrome (top bar + center row + bottom bar), faded in/out together -->
    <FrameLayout
        android:id="@+id/controls_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar: minimal, back + title only + subtitles/audio and quality icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/text_episode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_audio_subs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="CC"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_quality"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="&#9881;"
                android:textColor="#ffffff"
                android:textSize="19sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Center transport row: rewind10 - play/pause - forward10 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_rewind"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginEnd="30dp"
                android:gravity="center"
                android:text="&#8634;10"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:padding="24dp"
                android:src="@drawable/ic_play"
                android:contentDescription="Play/Pause" />

            <TextView
                android:id="@+id/btn_forward"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="30dp"
                android:gravity="center"
                android:text="10&#8635;"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Skip intro pill -->
        <TextView
            android:id="@+id/btn_skip_intro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="96dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Skip Intro"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Bottom bar: scrubber + current time (left) / remaining time (right), Netflix-style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progressTint="#6366f1"
                android:secondaryProgressTint="#66FFFFFF"
                android:thumbTint="#6366f1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/text_current_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="#e2e8f0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-00:00"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Playback error overlay - last child so it renders and receives touches
         above the (still-visible) transport controls it visually overlaps. -->
    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Retry"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
