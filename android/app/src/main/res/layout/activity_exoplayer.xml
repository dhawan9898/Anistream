<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix-style player chrome: back + centered title on top, bare
     replay10 / play-pause / forward10 in the middle, a red seek bar with
     remaining time and a Speed / Lock / Episodes / Audio & Subtitles /
     Next Ep. action row at the bottom. Skip Intro / Skip Outro / post-play
     live outside the auto-hiding chrome so they're always reachable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Transparent touch surface for gestures: double-tap seek, vertical swipe volume/brightness -->
    <View
        android:id="@+id/gesture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Buffering spinner (Netflix red) -->
    <ProgressBar
        android:id="@+id/buffering_spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#E50914"
        android:visibility="gone" />

    <!-- Gesture feedback indicator (volume / brightness) -->
    <TextView
        android:id="@+id/gesture_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- All auto-hiding chrome, faded in/out together -->
    <FrameLayout
        android:id="@+id/controls_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/scrim_top"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top" />

        <View
            android:id="@+id/scrim_bottom"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom" />

        <!-- Top bar: back | centered title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="64dp"
                android:layout_marginEnd="64dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/text_episode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#d2d2d2"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>

        <!-- Center transport row: replay10 - play/pause - forward10, bare icons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_rewind"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="56dp"
                android:contentDescription="Back 10 seconds">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/ic_replay" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:text="10"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:padding="8dp"
                android:src="@drawable/ic_play"
                android:contentDescription="Play/Pause" />

            <FrameLayout
                android:id="@+id/btn_forward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="56dp"
                android:contentDescription="Forward 10 seconds">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleX="-1"
                    android:src="@drawable/ic_replay" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:text="10"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom: red seek bar + remaining time, then the action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:progressTint="#E50914"
                    android:progressBackgroundTint="#FFFFFF"
                    android:secondaryProgressTint="#99FFFFFF"
                    android:thumbTint="#E50914" />

                <TextView
                    android:id="@+id/text_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_speed"
                    style="@style/NetflixPlayerAction">

                    <ImageView
                        style="@style/NetflixPlayerActionIcon"
                        android:src="@drawable/ic_speed" />

                    <TextView
                        android:id="@+id/text_speed_label"
                        style="@style/NetflixPlayerActionLabel"
                        android:text="Speed (1x)" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_lock"
                    style="@style/NetflixPlayerAction">

                    <ImageView
                        style="@style/NetflixPlayerActionIcon"
                        android:src="@drawable/ic_lock" />

                    <TextView
                        style="@style/NetflixPlayerActionLabel"
                        android:text="Lock" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_episodes"
                    style="@style/NetflixPlayerAction"
                    android:visibility="gone">

                    <ImageView
                        style="@style/NetflixPlayerActionIcon"
                        android:src="@drawable/ic_episodes" />

                    <TextView
                        style="@style/NetflixPlayerActionLabel"
                        android:text="Episodes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_audio_subs"
                    style="@style/NetflixPlayerAction">

                    <ImageView
                        style="@style/NetflixPlayerActionIcon"
                        android:src="@drawable/ic_subtitles" />

                    <TextView
                        style="@style/NetflixPlayerActionLabel"
                        android:text="Audio &amp; Subtitles" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_next_ep"
                    style="@style/NetflixPlayerAction"
                    android:visibility="gone">

                    <ImageView
                        style="@style/NetflixPlayerActionIcon"
                        android:src="@drawable/ic_skip_next" />

                    <TextView
                        style="@style/NetflixPlayerActionLabel"
                        android:text="Next Ep." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Skip Intro / Skip Outro / Watch Credits / Next Episode. Sits above
         the bottom bar while the chrome is up, drops to the corner when it
         hides (translationY is animated from code). -->
    <LinearLayout
        android:id="@+id/post_play_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_skip_intro"
            style="@style/NetflixSkipButton"
            android:text="Skip Intro" />

        <TextView
            android:id="@+id/btn_skip_outro"
            style="@style/NetflixSkipButton"
            android:text="Skip Outro" />

        <TextView
            android:id="@+id/btn_watch_credits"
            style="@style/NetflixSkipButton"
            android:text="Watch Credits" />

        <FrameLayout
            android:id="@+id/btn_next_episode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:visibility="gone">

            <View
                android:id="@+id/next_episode_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Play icon is set in code (ExoPlayerActivity.styleGlassChrome):
                 a "▶" text glyph renders as a large color emoji on many
                 phones, which made this button look oversized. -->
            <TextView
                android:id="@+id/next_episode_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="Next Episode"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Screen lock: shown briefly when the locked screen is tapped -->
    <LinearLayout
        android:id="@+id/unlock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_unlock"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="14dp"
            android:src="@drawable/ic_lock_open"
            android:contentDescription="Unlock screen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Screen Locked"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to unlock"
            android:textColor="#b3b3b3"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Playback error overlay - last child so it renders and receives touches
         above everything else. -->
    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Retry"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
