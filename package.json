{
  "name": "app",
  "private": true,
  "version": "10.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "tsx --test src/*/*.test.ts",
    "check-version": "node scripts/check-version.mjs",
    "sync-native": "node streamkit/android/sync-native.mjs --package com.anicli.stream --java android/app/src/main/java/com/anicli/stream --res android/app/src/main/res",
    "check-native": "node streamkit/android/sync-native.mjs --package com.anicli.stream --java android/app/src/main/java/com/anicli/stream --res android/app/src/main/res --check true",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/outfit": "^5.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamkit": "file:./streamkit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
